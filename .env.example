# Application Settings
APP_NAME="Bulk Certificate Generator"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration
# SQLite default for local development:
DATABASE_URL="sqlite:///./certificates.db"
# PostgreSQL example for production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/certificates_db"

# Storage Configuration
STORAGE_BACKEND="local"
STORAGE_LOCAL_DIR="generated_certificates"

# Generation Constraints
MAX_RECIPIENTS_PER_JOB=1000
MAX_CONCURRENT_WORKERS=4
